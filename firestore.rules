rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isMe(uid) { return signedIn() && request.auth.uid == uid; }
    // admin = có document admins/{uid} (tạo tay trong Firebase Console, client không ghi được)
    function isAdmin() { return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }

    // Dữ liệu học đồng bộ (cloud.js): mỗi người chỉ đọc/ghi của chính mình.
    // Riêng users/{uid}/usage do Cloud Function ghi (đếm lượt AI phía server) → client chỉ được đọc.
    match /users/{uid}/{col}/{doc} {
      allow read: if isMe(uid) && col in ['attempts', 'kv', 'usage'];
      allow delete: if isMe(uid) && col in ['attempts', 'kv'];
      allow create, update: if isMe(uid) && col in ['attempts', 'kv']
                            && request.resource.data.keys().hasOnly(['key', 'v', 'updatedAt'])
                            && request.resource.data.v is string
                            && request.resource.data.v.size() < 900000;
    }

    match /admins/{uid} {
      allow read: if isMe(uid);
      allow write: if false;
    }

    // Gói Pro: proUntil (ms). Người dùng chỉ đọc; chỉ admin cấp/gia hạn.
    match /plans/{uid} {
      allow read: if isMe(uid) || isAdmin();
      allow write: if isAdmin();
    }

    // Bộ đếm cũ — khóa ghi từ client để tránh tự đặt lại lượt AI; lượt thật nằm ở users/{uid}/usage/{day}.
    match /aiUsage/{uid} {
      allow read: if isMe(uid);
      allow write: if false;
    }

    // Yêu cầu thanh toán: người dùng tạo yêu cầu "pending" của chính mình; admin xem tất cả và duyệt / từ chối.
    match /payments/{id} {
      allow read: if (signedIn() && resource.data.uid == request.auth.uid) || isAdmin();
      allow create: if signedIn()
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.status == 'pending'
                    && request.resource.data.amount is int
                    && request.resource.data.amount > 0
                    && request.resource.data.code is string
                    && request.resource.data.code.size() <= 20
                    && request.resource.data.keys().hasOnly(['uid', 'email', 'name', 'code', 'amount', 'status', 'createdAt']);
      allow update, delete: if isAdmin();
    }

    // Báo lỗi câu hỏi / đề (FA.report trong common.js): người đã đăng nhập chỉ được TẠO báo cáo "open" của chính mình,
    // không đọc/sửa được; admin đọc, đổi trạng thái (fixed/ignored) và xóa ở admin.html.
    match /reports/{id} {
      allow read, update, delete: if isAdmin();
      allow create: if signedIn()
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.status == 'open'
                    && request.resource.data.keys().hasOnly(['uid', 'email', 'name', 'skill', 'testId', 'testTitle', 'ref', 'cat', 'msg', 'page', 'status', 'createdAt'])
                    && request.resource.data.cat in ['answer', 'text', 'audio', 'image', 'explain', 'other']
                    && request.resource.data.msg is string && request.resource.data.msg.size() <= 500
                    && request.resource.data.ref is string && request.resource.data.ref.size() <= 200
                    && request.resource.data.testTitle is string && request.resource.data.testTitle.size() <= 120
                    && request.resource.data.page is string && request.resource.data.page.size() <= 200
                    && request.resource.data.skill is string && request.resource.data.skill.size() <= 20
                    && request.resource.data.testId is string && request.resource.data.testId.size() <= 20
                    && request.resource.data.email is string && request.resource.data.email.size() <= 120
                    && request.resource.data.name is string && request.resource.data.name.size() <= 80
                    && request.resource.data.createdAt is int;
    }
  }
}
