{
  "name": "flashaptis",
  "version": "1.0.0",
  "description": "FlashAptis - web luyện thi Aptis ESOL (web tĩnh)",
  "private": true,
  "scripts": {
    "start": "npx --yes http-server public -a localhost -p 5501 -c-1 -o",
